# Build do painel admin (crm.sellergycloud.com): `npm run build:painel` no frontend.
# Copie pra .env.painel (fica fora do git) e ajuste os enderecos.
# API so do painel: cookies separados dos do site pelo proprio navegador.
VITE_API_URL=https://api-crm.sellergycloud.com
VITE_URL_PUBLICA=https://sellergycloud.com
VITE_HOST_PAINEL=crm.sellergycloud.com
VITE_URL_SITE=https://sellergycloud.com
