# =====================================================================
# .env de PRODUÇÃO do Sellergy Cloud — copie pra `.env` e preencha.
#   cp .env.production.example .env
#
# Gerar segredos:
#   openssl rand -hex 32      -> JWT_SECRET, DB_PASSWORD, MINIO_ROOT_PASSWORD
#   openssl rand -base64 32   -> MENSAGENS_MASTER_KEY (tem que ser EXATAMENTE
#                                32 bytes em base64; o backend recusa se não for)
#
# NUNCA commite o .env. Este arquivo de exemplo não tem segredo nenhum.
# =====================================================================

# ---------- Domínios (o Caddy emite TLS pra esses dois) ----------
# Registros DNS A apontando pro IP público da VM, ANTES do primeiro `up`.
API_DOMAIN=api.seudominio.com.br
CDN_DOMAIN=cdn.seudominio.com.br
# E-mail pro Let's Encrypt (avisos de expiração — o Caddy renova sozinho).
TLS_EMAIL=voce@seudominio.com.br

# ---------- Banco ----------
DB_USER=sellergy
DB_PASSWORD=TROQUE-openssl-rand-hex-32
DB_NAME=sellergy

# ---------- Backend ----------
JWT_SECRET=TROQUE-openssl-rand-hex-32
# Origens permitidas (CORS) = o domínio do FRONT na Vercel. Mais de um, separa
# por vírgula (ex.: domínio próprio + preview da Vercel). Sem localhost.
CORS_ORIGINS=https://sellergy-cloud.vercel.app
# Cookie de sessão. Front (Vercel) e API (esta VM) ficam em domínios
# DIFERENTES, então o navegador só envia o cookie com SameSite=None + Secure.
# Se um dia front e API ficarem no MESMO domínio raiz (app.x.com.br +
# api.x.com.br), dá pra apertar: COOKIE_SAMESITE=lax e COOKIE_DOMINIO=.x.com.br
COOKIE_SAMESITE=none
COOKIE_SECURE=true
#COOKIE_DOMINIO=
# Teto de requisições por IP por minuto (webhooks e /saude ficam de fora).
RATE_LIMIT_MAX=300

# ---------- Cofre (cifra credenciais e sessões Baileys em repouso) ----------
# Trocar depois de ter dado em produção = perder acesso a TUDO que foi cifrado
# (credenciais de PSP/fiscal/WhatsApp, sessões do WhatsApp Web). Guarde uma
# cópia desta chave FORA da VM.
MENSAGENS_MASTER_KEY=TROQUE-openssl-rand-base64-32

# ---------- MinIO (imagens de produto, PDF do catálogo) ----------
MINIO_ROOT_USER=sellergy-admin
MINIO_ROOT_PASSWORD=TROQUE-openssl-rand-hex-32
# Par que o backend usa. Pode ser igual ao root no começo; o ideal é criar
# uma chave de serviço no console do MinIO depois (DEPLOY.md §11).
MINIO_ACCESS_KEY=sellergy-admin
MINIO_SECRET_KEY=TROQUE-igual-ao-MINIO_ROOT_PASSWORD
MINIO_BUCKET_MIDIA=sellergy-midia
MINIO_REGION=us-east-1
# Endpoint PÚBLICO — o que o navegador usa nas URLs assinadas. É o CDN_DOMAIN
# acima, com https (o Caddy termina o TLS e repassa pro MinIO).
MINIO_PUBLIC_ENDPOINT=https://cdn.seudominio.com.br
# Backend -> MinIO é dentro da rede do Docker (http://minio:9000): sem TLS.
MINIO_USE_SSL=false

# ---------- Backup ----------
# Dias que os dumps diários ficam no volume `backup_data` antes de serem apagados.
BACKUP_RETENCAO_DIAS=14

# ---------- Integrações: chaves de "vai pra valer" ----------
# Emissão fiscal REAL — só depois da homologação na SEFAZ. true | false
FISCAL_LIVE=false
# Envio real de WhatsApp. 1 liga; qualquer outra coisa desliga (modo dry-run).
# Sem isso o bot não responde ninguém — em produção fica 1.
WHATSAPP_ENVIO_REAL=1
BAILEYS_ENVIO_REAL=1
# Versão da Graph API da Meta (só mexa se a Meta descontinuar a padrão).
#WHATSAPP_GRAPH_VERSAO=v21.0
# Atendimento com IA (DeepSeek): live bate na API; fixture responde simulado.
IA_MODO=live

# ---------- Diagnóstico (normalmente comentados) ----------
# Nível de log do Baileys (pino): trace | debug | info | warn | error
#BAILEYS_LOG_LEVEL=warn
# Desliga o cache Redis de relatórios/estoque pra depurar.
#CACHE_DISABLED=false
