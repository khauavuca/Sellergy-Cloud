# .env de PRODUÇÃO (VPS). Copie pra .env na VPS, preencha e proteja:
#   cp .env.production.example .env && chmod 600 .env
# NUNCA comite o .env (o .gitignore já bloqueia).
#
# Gere cada segredo com:          openssl rand -hex 32
# A MENSAGENS_MASTER_KEY é 32 bytes em base64:  openssl rand -base64 32
# Use hex nas senhas: elas entram em URLs (DATABASE_URL/REDIS_URL) e caracteres
# como @ : / quebrariam a conexão.
#
# Em produção o backend NÃO SOBE se um segredo estiver vazio, curto (< 32),
# repetitivo ou ainda com "TROQUE_AQUI" (backend/src/seguranca/validarAmbiente.js).

# --- Domínios (registro A de cada um apontando pro IP da VPS) ---
API_DOMINIO=api.sellergycloud.com
MIDIA_DOMINIO=midia.sellergycloud.com
# Só se o front rodar na VPS (profile "frontend"); com o front na Hostinger, deixe vazio.
APP_DOMINIO=

# --- Postgres ---
DB_USER=sellergy
DB_PASSWORD=TROQUE_AQUI_openssl_rand_hex_32
DB_NAME=sellergy_cloud

# --- Redis (filas BullMQ, cache, sessões do WhatsApp) ---
# O compose monta REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379 sozinho.
REDIS_PASSWORD=TROQUE_AQUI_openssl_rand_hex_32

# --- MinIO (fotos e arquivos) ---
MINIO_ROOT_USER=sellergy
# Mínimo 32 caracteres (openssl rand -hex 32).
MINIO_ROOT_PASSWORD=TROQUE_AQUI_openssl_rand_hex_32
MINIO_ACCESS_KEY=sellergy
# Mesmo valor do MINIO_ROOT_PASSWORD (ou de um usuário só do bucket, ver DEPLOY.md).
MINIO_SECRET_KEY=TROQUE_AQUI_MESMO_VALOR_DO_MINIO_ROOT_PASSWORD
MINIO_BUCKET_MIDIA=sellergy-midia
MINIO_REGION=us-east-1
MINIO_USE_SSL=false

# --- Backend ---
BACKEND_PORT=3333
JWT_SECRET=TROQUE_AQUI_openssl_rand_hex_32
MENSAGENS_MASTER_KEY=TROQUE_AQUI_openssl_rand_base64_32
# Endereço do front (Hostinger). Com e sem www. Só https://, nunca * ou localhost.
CORS_ORIGINS=https://sellergycloud.com,https://www.sellergycloud.com
# Front (sellergycloud.com) e API (api.sellergycloud.com) são o mesmo "site":
# lax já basta e protege mais contra CSRF.
COOKIE_SAMESITE=lax
COOKIE_SECURE=true
RATE_LIMIT_MAX=300

# --- Segurança do painel ---
# true = admin só entra no painel com o código de 2 etapas (TOTP) ativado.
# (O código compara com "true" exato; "1" NÃO liga.)
ADMIN_2FA_OBRIGATORIO=true

# --- Cobrança da própria plataforma (Asaas) ---
# Chave da API da CONTA DO SELLERGY no Asaas (não a dos clientes).
ASAAS_PLATAFORMA_API_KEY=
# sandbox | producao  (padrão sandbox: cobranças de teste)
ASAAS_PLATAFORMA_AMBIENTE=sandbox
# Token que o Asaas manda no header do webhook. Sem ele a rota recusa tudo.
# Obrigatório quando ASAAS_PLATAFORMA_API_KEY estiver preenchida (openssl rand -hex 32).
ASAAS_PLATAFORMA_WEBHOOK_TOKEN=

# --- Avisos da plataforma pelo WhatsApp ---
# Id do Cliente (negócio) do PRÓPRIO Sellergy, cujo WhatsApp conectado manda
# os avisos de cobrança/plano pros clientes. Vazio = só aviso dentro do sistema.
PLATAFORMA_CLIENTE_ID=

# --- Integrações (ligar só quando estiver pronto) ---
IA_MODO=fixture
FISCAL_LIVE=false
# 1 = envia de verdade; 0 = só registra no log (o código compara com "1" exato).
WHATSAPP_ENVIO_REAL=0
BAILEYS_ENVIO_REAL=0

# Base dos links enviados por WhatsApp (lembrete, agendamento). = endereco do front.
APP_URL_PUBLICA=https://sellergycloud.com
# Endereco https da API (webhooks da subconta Asaas e do Mercado Pago).
API_URL_PUBLICA=https://api.sellergycloud.com

# --- Pagamentos dos negocios (Pix, link, sinal, pedido) ---
# true = cobra de verdade no provedor do negocio. Sem isso, tudo e simulado.
PAGAMENTO_LIVE=false
# producao | sandbox, pra credencial que nao diz o ambiente.
PAGAMENTO_AMBIENTE_PADRAO=producao

# --- Campanhas pelo WhatsApp Web (QR Code) ---
# bloqueado = pausa todas as campanhas pelo QR Code (emergencia). Vazio = liberado.
CAMPANHA_CANAL_NAO_OFICIAL=

# --- Front (usado no build: npm run build com estas variáveis) ---
VITE_API_URL=https://api.sellergycloud.com
VITE_URL_PUBLICA=https://api.sellergycloud.com
